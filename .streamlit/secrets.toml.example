# Copy to .streamlit/secrets.toml and fill in. Never commit the real file.

# --- Supabase (required: dashboard, vehicles, history) ---
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_KEY = "<anon-or-service-key>"

# --- Swiftly transit API (required: active blocks) ---
SWIFTLY_AUTH = "<swiftly-api-key>"

# --- ChargePoint SOAP API (required: charger sessions) ---
CHARGEPOINT_KEY = "<chargepoint-license-key>"
CHARGEPOINT_PASSWD = "<chargepoint-password>"

# --- Error notification email ---
EMAIL = "<sender@example.com>"
EMAIL_PASSWD = "<app-password>"

# --- Visual Crossing weather (energy consumption model) ---
VISUAL_CROSSING_KEY = "<api-key>"
